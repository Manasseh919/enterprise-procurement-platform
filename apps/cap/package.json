{
  "name": "cap",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/postgres": "^3.0.1",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@types/node": "^24.0.0",
    "tsx": "^4",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch:pg": "cds watch --profile pg",
    "deploy:pg": "cds deploy --profile pg"
  },
  "cds": {
    "requires": {
      "db": {
        "[pg]": {
          "kind": "postgres",
          "pool": {
            "acquireTimeoutMillis": 30000,
            "destroyTimeoutMillis": 10000
          }
        }
      }
    }
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}