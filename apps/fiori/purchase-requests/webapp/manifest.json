{
    "_version": "1.76.0",
    "sap.app": {
      "id": "epp.purchaserequests",
      "type": "application",
      "i18n": {
        "bundleUrl": "i18n/i18n.properties",
        "supportedLocales": ["", "en", "en_US"],
        "fallbackLocale": ""
      },
      "title": "{{appTitle}}",
      "description": "{{appDescription}}",
      "applicationVersion": {
        "version": "1.0.0"
      },
      "dataSources": {
        "mainService": {
          "uri": "/odata/v4/procurement/",
          "type": "OData",
          "settings": {
            "annotations": [],
            "odataVersion": "4.0"
          }
        }
      }
    },
    "sap.ui": {
      "technology": "UI5",
      "fullWidth": true,
      "deviceTypes": {
        "desktop": true,
        "tablet": true,
        "phone": true
      }
    },
    "sap.ui5": {
      "flexEnabled": false,
      "dependencies": {
        "minUI5Version": "1.136.0",
        "libs": {
          "sap.m": {},
          "sap.ui.core": {},
          "sap.fe.templates": {}
        }
      },
      "models": {
        "i18n": {
          "type": "sap.ui.model.resource.ResourceModel",
          "settings": {
            "bundleName": "epp.purchaserequests.i18n.i18n",
            "supportedLocales": ["", "en", "en_US"],
            "fallbackLocale": ""
          }
        },
        "": {
          "dataSource": "mainService",
          "preload": true,
          "settings": {
            "operationMode": "Server",
            "autoExpandSelect": true,
            "earlyRequests": true
          }
        }
      },
      "routing": {
        "routes": [
          {
            "pattern": ":?query:",
            "name": "PurchaseRequestsList",
            "target": "PurchaseRequestsList"
          },
          {
            "pattern": "PurchaseRequests({key}):?query:",
            "name": "PurchaseRequestsObjectPage",
            "target": "PurchaseRequestsObjectPage"
          }
        ],
        "targets": {
          "PurchaseRequestsList": {
            "type": "Component",
            "id": "PurchaseRequestsList",
            "name": "sap.fe.templates.ListReport",
            "options": {
              "settings": {
                "contextPath": "/PurchaseRequests",
                "variantManagement": "None",
                "initialLoad": "Enabled",
                "navigation": {
                  "PurchaseRequests": {
                    "detail": {
                      "route": "PurchaseRequestsObjectPage"
                    }
                  }
                }
              }
            }
          },
          "PurchaseRequestsObjectPage": {
            "type": "Component",
            "id": "PurchaseRequestsObjectPage",
            "name": "sap.fe.templates.ObjectPage",
            "options": {
              "settings": {
                "editableHeaderContent": false,
                "contextPath": "/PurchaseRequests"
              }
            }
          }
        }
      },
      "contentDensities": {
        "compact": true,
        "cozy": true
      }
    },
    "sap.fiori": {
      "registrationIds": [],
      "archeType": "transactional"
    }
  }